# Reference only. Supply values through the server process or the hosting provider's secret store.
# Never use VITE_ prefixes, commit real credentials, or put provider secrets in browser storage.

# Required: one shared application password (minimum 16 characters).
APP_ACCESS_PASSWORD=

# Required: random signing key, minimum 32 characters. Rotate to revoke all sessions.
APP_SESSION_SECRET=

# Server-side analysis configuration. These values are never sent to the browser.
ANALYSIS_MODE=demo
ANALYSIS_BATCH_SIZE=50
ENABLE_AUTO_ANALYSIS=true

# Trusted adapter URLs (not provider API URLs): HTTPS hosts must be listed in DATA_API_ALLOWED_HOSTS.
SHOPIFY_ADAPTER_URL=
GA4_ADAPTER_URL=
SEARCH_CONSOLE_ADAPTER_URL=
DATA_API_ALLOWED_HOSTS=

# Optional server-side Google Ads defaults. Alternatively, paste these into the dashboard for one run.
# Native Google Ads REST integration (OAuth + developer token; no API key or adapter URL).
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Private bearer tokens used only to authenticate to your own trusted adapters.
# The adapters must perform provider OAuth and return LP Radar's normalized LP JSON format.
SHOPIFY_ADAPTER_TOKEN=
GA4_ADAPTER_TOKEN=
SEARCH_CONSOLE_ADAPTER_TOKEN=
