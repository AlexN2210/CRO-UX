# Reference only. Supply values through the server process or the hosting provider's secret store.
# Never use VITE_ prefixes, commit real credentials, or put provider secrets in browser storage.

# Required: one shared application password (minimum 16 characters).
APP_ACCESS_PASSWORD=

# Required: random signing key, minimum 32 characters. Rotate to revoke all sessions.
APP_SESSION_SECRET=

# Server-side analysis configuration. These values are never sent to the browser.
ANALYSIS_MODE=demo
ANALYSIS_BATCH_SIZE=50
ENABLE_AUTO_ANALYSIS=true

# API URLs must use HTTPS and their exact host must also appear in DATA_API_ALLOWED_HOSTS.
GOOGLE_ADS_API_URL=
SHOPIFY_API_URL=
GA4_API_URL=
SEARCH_CONSOLE_API_URL=
DATA_API_ALLOWED_HOSTS=

# Provider credentials: set only when the matching URL is configured.
GOOGLE_ADS_API_KEY=
SHOPIFY_ACCESS_TOKEN=
GA4_API_KEY=
SEARCH_CONSOLE_API_KEY=
