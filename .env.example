# Production configuration for LP Radar
# Copy this file to .env.local and fill in your real URLs / tokens.

VITE_ANALYSIS_MODE=demo
VITE_ENABLE_AUTO_ANALYSIS=true
VITE_ANALYSIS_BATCH_SIZE=50

# Google Ads API / backend endpoint
VITE_GOOGLE_ADS_API_URL=

# Shopify Admin API / backend endpoint
VITE_SHOPIFY_API_URL=

# Optional analytics / reporting sources
VITE_GA4_API_URL=
VITE_SEARCH_CONSOLE_API_URL=

# Optional auth secrets stored server-side only
# VITE_GOOGLE_CLIENT_ID=
# VITE_SHOPIFY_ACCESS_TOKEN=
